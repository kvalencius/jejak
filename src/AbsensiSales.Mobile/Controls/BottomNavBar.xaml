<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="AbsensiSales.Mobile.Controls.BottomNavBar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <!-- Navbar bawah mengambang. Biru tua dibuat agak transparan agar tidak
         terlalu berat. Tab aktif ditandai pil kuning tua yang menjulang sedikit
         ke atas seperti tab pembatas buku.
         Grid induk sengaja lebih tinggi dari badan navbar supaya bagian pil
         yang menjulang tidak terpotong. Latar alpha 1 membuat seluruh area
         navbar menangkap sentuhan, termasuk padding dan baris pil — tanpa itu
         tap di sela-sela tab bisa tembus ke tombol halaman di bawahnya. -->
    <Grid
        x:Name="RootGrid"
        HeightRequest="60"
        Padding="6,0"
        MaximumWidthRequest="380"
        HorizontalOptions="Fill"
        BackgroundColor="#01000000"
        RowDefinitions="6,54">

        <!-- Badan navbar (baris bawah) -->
        <Border
            Grid.Row="1"
            BackgroundColor="{StaticResource NavyBar}"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 16">
            <Border.Shadow>
                <Shadow
                    Brush="#10243D"
                    Radius="14"
                    Opacity="0.22"
                    Offset="0,4" />
            </Border.Shadow>
        </Border>

        <!-- Penanda tab aktif. Berada di luar Border badan navbar supaya bagian
             yang menjulang ke atas tidak terpotong sudut membulat. -->
        <Border
            x:Name="Indicator"
            Grid.Row="0"
            Grid.RowSpan="2"
            BackgroundColor="#FFE5A422"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 14"
            WidthRequest="74"
            HorizontalOptions="Start"
            VerticalOptions="Fill"
            InputTransparent="True">
            <Border.Shadow>
                <Shadow
                    Brush="#10243D"
                    Radius="8"
                    Opacity="0.3"
                    Offset="0,-2" />
            </Border.Shadow>
        </Border>

        <!-- Item tab (baris bawah) -->
        <Grid
            x:Name="Items"
            Grid.Row="1"
            ColumnDefinitions="*,*,*">

            <!-- Absensi -->
            <Border
                Grid.Column="0"
                BackgroundColor="#01FFFFFF"
                StrokeThickness="0"
                Padding="0"
                AutomationId="TabAbsensi">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAbsensiTapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout
                    x:Name="AbsensiContent"
                    Spacing="2"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <Path
                        Data="M19,3H18V1H16V3H8V1H6V3H5C3.89,3 3,3.9 3,5V19C3,20.1 3.89,21 5,21H19C20.1,21 21,20.1 21,19V5C21,3.9 20.1,3 19,3M19,19H5V8H19V19M9.5,16.5L7,14L5.6,15.4L9.5,19.3L15.9,12.9L14.5,11.5L9.5,16.5Z"
                        Fill="#FFFFFF"
                        Aspect="Uniform"
                        WidthRequest="18"
                        HeightRequest="18"
                        HorizontalOptions="Center" />
                    <Label
                        Text="Absensi"
                        TextColor="#FFFFFF"
                        FontSize="10"
                        FontFamily="OpenSansSemibold"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Laporan -->
            <Border
                Grid.Column="1"
                BackgroundColor="#01FFFFFF"
                StrokeThickness="0"
                Padding="0"
                AutomationId="TabLaporan">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLaporanTapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout
                    x:Name="LaporanContent"
                    Spacing="2"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <Path
                        Data="M4,9 L8,9 L8,20 L4,20 Z M10,4 L14,4 L14,20 L10,20 Z M16,12 L20,12 L20,20 L16,20 Z"
                        Fill="#FFFFFF"
                        Aspect="Uniform"
                        WidthRequest="18"
                        HeightRequest="18"
                        HorizontalOptions="Center" />
                    <Label
                        Text="Laporan"
                        TextColor="#FFFFFF"
                        FontSize="10"
                        FontFamily="OpenSansSemibold"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Profil -->
            <Border
                Grid.Column="2"
                BackgroundColor="#01FFFFFF"
                StrokeThickness="0"
                Padding="0"
                AutomationId="TabProfil">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnProfilTapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout
                    x:Name="ProfilContent"
                    Spacing="2"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <Path
                        Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"
                        Fill="#FFFFFF"
                        Aspect="Uniform"
                        WidthRequest="18"
                        HeightRequest="18"
                        HorizontalOptions="Center" />
                    <Label
                        Text="Profil"
                        TextColor="#FFFFFF"
                        FontSize="10"
                        FontFamily="OpenSansSemibold"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

        </Grid>
    </Grid>
</ContentView>
