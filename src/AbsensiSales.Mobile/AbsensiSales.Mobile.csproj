<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Mockup berjalan di Windows. net10.0-android ditambahkan agar
		     aplikasi bisa dibuild & dijalankan di HP Android (scrcpy/adb). -->
		<TargetFrameworks>net10.0-windows10.0.19041.0;net10.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>AbsensiSales.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>Jejak Sales</ApplicationTitle>
		<ApplicationId>com.indopelita.jejaksales</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">34.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#2B2319" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#2B2319" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\logo_jejak.png" BaseSize="120,120" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

		<!-- Model wajah: dipakai langsung sebagai MauiAsset di Android/iOS dan
		     disalin ke folder output agar bisa dibaca dari Windows.
		     File .onnx tidak di-commit (lihat .gitignore dan models/README.md). -->
		<MauiAsset Include="..\..\models\*.onnx" LogicalName="%(Filename)%(Extension)" Condition="Exists('..\..\models\version-RFB-320.onnx')" />
		<None Include="..\..\models\*.onnx" Link="models\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\models\version-RFB-320.onnx')" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="8.0.3" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="Shiny.Maui.Controls.Keyframe" Version="2.5.0" />
		<PackageReference Include="SQLite" Version="3.54.0" />
		<PackageReference Include="SQLitePCLRaw.core" Version="3.0.5" />
		<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
		<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.android" Version="2.1.11" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AbsensiSales.Core\AbsensiSales.Core.csproj" />
		<ProjectReference Include="..\AbsensiSales.Face\AbsensiSales.Face.csproj" />
	</ItemGroup>

</Project>
