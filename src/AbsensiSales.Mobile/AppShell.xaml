<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AbsensiSales.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:AbsensiSales.Mobile.Views"
    Shell.FlyoutBehavior="Disabled">

    <!-- Halaman awal: Login -->
    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="login" />

    <!-- Tab utama setelah login -->
    <TabBar Route="utama">
        <ShellContent
            Title="Absensi"
            ContentTemplate="{DataTemplate views:AbsensiPertamaPage}"
            Route="absensi" />
        <ShellContent
            Title="Laporan"
            ContentTemplate="{DataTemplate views:LaporanPage}"
            Route="laporan" />
    </TabBar>

</Shell>
