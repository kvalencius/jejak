<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AbsensiSales.Mobile.Views.PengajuanIzinPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AbsensiSales.Mobile.ViewModels"
    x:DataType="vm:PengajuanIzinViewModel"
    Title="Pengajuan Izin"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,24" Spacing="0">

            <Label Text="Ajukan permohonan" Style="{StaticResource TitleLabel}" Margin="0,0,0,4" />
            <Label Text="Pengajuan cuti atau izin sakit akan diteruskan ke HR untuk disetujui." Style="{StaticResource SubtitleLabel}" Margin="0,0,0,14" />

            <Border Style="{StaticResource CardBorder}" Padding="20,24">
                <VerticalStackLayout Spacing="14">

                    <Label Text="Jenis permohonan" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Border Grid.Column="0" Style="{StaticResource ChoiceCard}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding Jenis}" Value="Cuti">
                                    <Setter Property="BackgroundColor" Value="{StaticResource InfoBg}" />
                                    <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PilihCutiCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="Cuti" HorizontalOptions="Center" TextColor="{StaticResource TextSecondary}" FontFamily="OpenSansSemibold">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding Jenis}" Value="Cuti">
                                        <Setter Property="TextColor" Value="{StaticResource PrimaryDark}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource ChoiceCard}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding Jenis}" Value="Izin Sakit">
                                    <Setter Property="BackgroundColor" Value="{StaticResource InfoBg}" />
                                    <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PilihSakitCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="Izin Sakit" HorizontalOptions="Center" TextColor="{StaticResource TextSecondary}" FontFamily="OpenSansSemibold">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding Jenis}" Value="Izin Sakit">
                                        <Setter Property="TextColor" Value="{StaticResource PrimaryDark}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </Grid>

                    <Label Text="Tanggal mulai" Style="{StaticResource FieldLabel}" Margin="0,4,0,6" />
                    <Border Style="{StaticResource InputCard}">
                        <DatePicker Date="{Binding TanggalMulai}" />
                    </Border>

                    <Label Text="Tanggal selesai" Style="{StaticResource FieldLabel}" Margin="0,4,0,6" />
                    <Border Style="{StaticResource InputCard}">
                        <DatePicker Date="{Binding TanggalSelesai}" />
                    </Border>

                    <Label Text="Alasan" Style="{StaticResource FieldLabel}" Margin="0,4,0,6" />
                    <Border Style="{StaticResource InputCardMultiline}">
                        <Editor Text="{Binding Alasan}" Placeholder="Tuliskan alasan permohonan..." />
                    </Border>

                    <Label Text="Lampiran surat / bukti (opsional)" Style="{StaticResource FieldLabel}" Margin="0,4,0,6" />
                    <Border Style="{StaticResource InputCard}">
                        <Entry Text="{Binding Lampiran}" Placeholder="Nama file surat/dokter" />
                    </Border>

                    <Label Text="{Binding PesanError}"
                           TextColor="{StaticResource Danger}"
                           FontSize="13"
                           IsVisible="{Binding PesanError, Converter={StaticResource StringNotEmptyConverter}}" />

                </VerticalStackLayout>
            </Border>

            <Button Text="Kirim permohonan >" Style="{StaticResource PrimaryButton}" Command="{Binding KirimCommand}" Margin="0,16,0,8" AutomationId="ButtonKirimIzin" />
            <Button Text="Batal" Style="{StaticResource GhostButton}" Command="{Binding BatalCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
