<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AbsensiSales.Mobile.Views.VerifikasiDataPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AbsensiSales.Mobile.ViewModels"
    x:DataType="vm:VerifikasiDataViewModel"
    Title="Verifikasi Data"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,24" Spacing="0">

            <Label Text="Verifikasi data" Style="{StaticResource TitleLabel}" Margin="0,0,0,4" />
            <Label Text="Kunjungan - Tahap 5 dari 5" Style="{StaticResource SubtitleLabel}" Margin="0,0,0,12" />

            <!-- Status tersimpan -->
            <Border BackgroundColor="{StaticResource SuccessBg}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="14" Margin="0,0,0,14" IsVisible="{Binding Tersimpan}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="OK: Data berhasil tersimpan" TextColor="{StaticResource Success}" FontFamily="OpenSansSemibold" FontSize="14" />
                    <Label Text="Semua bukti lengkap. Kunjungan tercatat di laporan." TextColor="{StaticResource TextSecondary}" FontSize="12" />
                    <Label Text="{Binding NomorKunjungan, StringFormat='{0}'}" TextColor="{StaticResource TextSecondary}" FontSize="12" />
                    <Label Text="{Binding WaktuKunjungan}" TextColor="{StaticResource TextSecondary}" FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <!-- Gagal validasi -->
            <Border BackgroundColor="{StaticResource DangerBg}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="14" Margin="0,0,0,14" IsVisible="{Binding ValidasiGagal}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Data belum dapat disimpan" TextColor="{StaticResource Danger}" FontFamily="OpenSansSemibold" FontSize="14" />
                    <Label Text="{Binding PesanGagal}" TextColor="{StaticResource Danger}" FontSize="12" />
                    <Button Text="Kembali ke Pengisian Data Toko" Style="{StaticResource SecondaryButton}" Command="{Binding KembaliKeTokoCommand}" HeightRequest="44" />
                </VerticalStackLayout>
            </Border>

            <!-- Ringkasan kunjungan -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{Binding NamaToko}" FontFamily="OpenSansSemibold" FontSize="16" />
                        <Label Grid.Column="1" Text="Tersimpan" Style="{StaticResource BadgeSuccess}" IsVisible="{Binding Tersimpan}" />
                    </Grid>
                    <Label Text="{Binding InfoToko}" Style="{StaticResource SubtitleLabel}" />
                    <Label Text="{Binding Tujuan}" FontSize="13" Margin="0,4,0,0" />
                    <Label Text="{Binding Alamat}" Style="{StaticResource SubtitleLabel}" />
                </VerticalStackLayout>
            </Border>

            <!-- Bukti yang diverifikasi -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Bukti yang diverifikasi" Style="{StaticResource SectionTitle}" />

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Border Grid.Column="0" BackgroundColor="{StaticResource InfoBg}" StrokeThickness="0" StrokeShape="RoundRectangle 18" WidthRequest="34" HeightRequest="34">
                            <Label Text="GPS" TextColor="{StaticResource PrimaryDark}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Lokasi GPS" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            <Label Text="{Binding InfoGps}" FontFamily="OpenSansSemibold" FontSize="13" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="OK" TextColor="{StaticResource Success}" FontSize="16" VerticalOptions="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Border Grid.Column="0" BackgroundColor="{StaticResource InfoBg}" StrokeThickness="0" StrokeShape="RoundRectangle 18" WidthRequest="34" HeightRequest="34">
                            <Label Text="JAM" TextColor="{StaticResource PrimaryDark}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Waktu absensi" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            <Label Text="{Binding InfoWaktu}" FontFamily="OpenSansSemibold" FontSize="13" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="OK" TextColor="{StaticResource Success}" FontSize="16" VerticalOptions="Center" />
                    </Grid>

                    <!-- Thumbnail bukti -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Border BackgroundColor="{StaticResource Navy}" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="90">
                                <Label Text="WAJAH" FontSize="30" TextColor="{StaticResource TextOnNavy}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="{Binding InfoWajah}" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Border BackgroundColor="{StaticResource Navy}" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="90">
                                <Label Text="TOKO" FontSize="30" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="Foto toko - bukti kunjungan" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="Lihat laporan kunjungan >" Style="{StaticResource PrimaryButton}" Command="{Binding LihatLaporanCommand}" IsVisible="{Binding Tersimpan}" AutomationId="ButtonLihatLaporan" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
