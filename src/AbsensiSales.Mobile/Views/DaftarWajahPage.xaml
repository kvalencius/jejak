<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AbsensiSales.Mobile.Views.DaftarWajahPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:AbsensiSales.Mobile.Controls"
    xmlns:vm="clr-namespace:AbsensiSales.Mobile.ViewModels"
    x:DataType="vm:DaftarWajahViewModel"
    Title="Daftar Wajah"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20,20,20,24" Spacing="0">

                <controls:BackButton Margin="0,0,0,12" />

                <Label Text="Daftarkan wajah" Style="{StaticResource TitleLabel}" Margin="0,0,0,6" />
                <Label Text="{Binding NamaSales, StringFormat='Wajah untuk {0}'}" Style="{StaticResource SubtitleLabel}" Margin="0,0,0,16" />

                <!-- Pratinjau / panduan posisi wajah -->
                <controls:SolidCard Tone="Navy" Padding="0" HeightRequest="280" StrokeShape="RoundRectangle 24">
                    <Grid RowDefinitions="Auto,*,Auto">

                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="16,14,16,0">
                            <Label Text="KAMERA WAJAH" TextColor="{StaticResource White}" FontSize="10" FontFamily="OpenSansSemibold" />
                            <Label Grid.Column="1" Text="FOTO TIDAK DISIMPAN" TextColor="{StaticResource Yellow}" FontSize="10" FontFamily="OpenSansSemibold" />
                        </Grid>

                        <Grid Grid.Row="1" Padding="16,12">
                            <!-- Lingkaran panduan -->
                            <Border
                                WidthRequest="190"
                                HeightRequest="190"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                BackgroundColor="Transparent"
                                Stroke="{StaticResource Yellow}"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 95"
                                IsVisible="{Binding AdaFoto, Converter={StaticResource InvertedBoolConverter}}" />

                            <!-- Hasil foto -->
                            <Border
                                WidthRequest="190"
                                HeightRequest="190"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                StrokeThickness="2"
                                Stroke="{StaticResource Mint}"
                                StrokeShape="RoundRectangle 95"
                                Padding="0"
                                IsVisible="{Binding AdaFoto}">
                                <Image Source="{Binding PratinjauFoto}" Aspect="AspectFill" />
                            </Border>
                        </Grid>

                        <Border
                            Grid.Row="2"
                            Margin="16,0,16,16"
                            Padding="16,9"
                            BackgroundColor="{StaticResource NavyDeep}"
                            HorizontalOptions="Center"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 14">
                            <Label
                                Text="{Binding JudulStatus}"
                                TextColor="{StaticResource White}"
                                FontFamily="OpenSansSemibold"
                                FontSize="12"
                                HorizontalTextAlignment="Center" />
                        </Border>
                    </Grid>
                </controls:SolidCard>

                <Label
                    Text="{Binding PesanStatus}"
                    FontSize="12"
                    TextColor="{StaticResource TextSecondary}"
                    HorizontalTextAlignment="Center"
                    Margin="0,12,0,0" />

                <HorizontalStackLayout
                    Spacing="8"
                    HorizontalOptions="Center"
                    Margin="0,10,0,0"
                    IsVisible="{Binding SedangMemproses}">
                    <ActivityIndicator
                        Color="{StaticResource Navy}"
                        WidthRequest="18"
                        HeightRequest="18"
                        VerticalOptions="Center"
                        IsRunning="{Binding SedangMemproses}" />
                    <Label
                        Text="Mohon tunggu"
                        FontSize="12"
                        TextColor="{StaticResource TextSecondary}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Button
                    Text="Ambil foto wajah"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding AmbilFotoCommand}"
                    Margin="0,18,0,10"
                    AutomationId="ButtonAmbilFotoWajah" />

                <Button
                    Text="Simpan wajah"
                    Style="{StaticResource NavyButton}"
                    Command="{Binding SimpanCommand}"
                    IsVisible="{Binding SiapDisimpan}"
                    Margin="0,0,0,10"
                    AutomationId="ButtonSimpanWajah" />

                <Button
                    Text="Lanjut"
                    Style="{StaticResource NavyButton}"
                    Command="{Binding LanjutCommand}"
                    Margin="0,0,0,10"
                    AutomationId="ButtonLanjutWajah" />

                <controls:SolidCard Tone="Yellow" Padding="16" Margin="0,10,0,0">
                    <VerticalStackLayout Spacing="8">
                        <Label
                            Text="Agar wajah mudah dikenali"
                            TextColor="{StaticResource Navy}"
                            FontFamily="OpenSansSemibold"
                            FontSize="13" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Text="•" TextColor="{StaticResource Navy}" FontSize="12" />
                            <Label
                                Grid.Column="1"
                                Text="Hadapkan wajah lurus ke kamera dengan cahaya cukup."
                                TextColor="{StaticResource TextSecondary}"
                                FontSize="11" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Text="•" TextColor="{StaticResource Navy}" FontSize="12" />
                            <Label
                                Grid.Column="1"
                                Text="Lepas masker, kacamata gelap, topi, atau penutup wajah."
                                TextColor="{StaticResource TextSecondary}"
                                FontSize="11" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Text="•" TextColor="{StaticResource Navy}" FontSize="12" />
                            <Label
                                Grid.Column="1"
                                Text="Pastikan hanya wajah Anda yang ada dalam foto."
                                TextColor="{StaticResource TextSecondary}"
                                FontSize="11" />
                        </Grid>
                    </VerticalStackLayout>
                </controls:SolidCard>

            </VerticalStackLayout>
        </ScrollView>

        <controls:NotificationHost />
    </Grid>
</ContentPage>
