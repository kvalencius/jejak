<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AbsensiSales.Mobile.Views.FotoTokoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AbsensiSales.Mobile.ViewModels"
    x:DataType="vm:FotoTokoViewModel"
    Title="Foto Toko"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,24" Spacing="0">

            <Label Text="Foto dengan toko" Style="{StaticResource TitleLabel}" Margin="0,0,0,4" />
            <Label Text="{Binding LabelToko, StringFormat='{0} - Tahap 4 dari 5'}" Style="{StaticResource SubtitleLabel}" Margin="0,0,0,14" />

            <!-- Pratinjau foto -->
            <Border BackgroundColor="{StaticResource Navy}" StrokeThickness="0" StrokeShape="RoundRectangle 16" HeightRequest="280" Padding="0">
                <Grid>
                    <Label Text="Pratinjau foto" BackgroundColor="#CC2B2319" TextColor="White" FontSize="12" Padding="8,4" HorizontalOptions="Start" VerticalOptions="Start" Margin="12,12,0,0" />

                    <!-- Placeholder / foto -->
                    <Image Source="{Binding PratinjauFoto}" Aspect="AspectFill" IsVisible="{Binding FotoSiap}" />
                    <Label Text="FOTO" FontSize="48" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding FotoSiap, Converter={StaticResource InvertedBoolConverter}}" />

                    <VerticalStackLayout BackgroundColor="#CC2B2319" Padding="12,8" HorizontalOptions="Fill" VerticalOptions="End" Spacing="2">
                        <Label Text="{Binding LabelToko}" TextColor="White" FontFamily="OpenSansSemibold" FontSize="13" />
                        <Label Text="Pastikan wajah sales dan tampak toko terlihat" TextColor="{StaticResource TextOnNavy}" FontSize="11" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Kontrol kamera -->
            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="16" Margin="0,16,0,14" HorizontalOptions="Center">
                <Button Grid.Column="0" Text="Ambil ulang" Style="{StaticResource GhostButton}" Command="{Binding AmbilFotoCommand}" />
                <Border Grid.Column="1" BackgroundColor="{StaticResource Primary}" StrokeThickness="0" StrokeShape="RoundRectangle 30" WidthRequest="60" HeightRequest="60">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AmbilFotoCommand}" />
                    </Border.GestureRecognizers>
                </Border>
                <Button Grid.Column="2" Text="Kamera" Style="{StaticResource GhostButton}" Command="{Binding AmbilFotoCommand}" />
            </Grid>

            <!-- Bukti kunjungan -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Bukti kunjungan" Style="{StaticResource SectionTitle}" />
                        <Label Grid.Column="1" Text="Foto siap" Style="{StaticResource BadgeSuccess}" IsVisible="{Binding FotoSiap}" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Border Grid.Column="0" BackgroundColor="{StaticResource InfoBg}" StrokeThickness="0" StrokeShape="RoundRectangle 18" WidthRequest="34" HeightRequest="34">
                            <Label Text="FOTO" FontSize="11" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Foto toko" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            <Label Text="{Binding InfoFoto}" FontFamily="OpenSansSemibold" FontSize="13" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="OK" TextColor="{StaticResource Success}" FontSize="16" VerticalOptions="Center" IsVisible="{Binding FotoSiap}" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Border Grid.Column="0" BackgroundColor="{StaticResource InfoBg}" StrokeThickness="0" StrokeShape="RoundRectangle 18" WidthRequest="34" HeightRequest="34">
                            <Label Text="GPS" TextColor="{StaticResource PrimaryDark}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="GPS saat pengambilan" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            <Label Text="{Binding InfoGps}" FontFamily="OpenSansSemibold" FontSize="13" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="OK" TextColor="{StaticResource Success}" FontSize="16" VerticalOptions="Center" IsVisible="{Binding DalamRadius}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="Pastikan wajah sales dan bagian depan toko terlihat. Foto buram? Ambil ulang sebelum melanjutkan." Style="{StaticResource SubtitleLabel}" Margin="0,0,0,14" />

            <Button Text="Gunakan foto &amp; tinjau data >" Style="{StaticResource PrimaryButton}" Command="{Binding GunakanFotoCommand}" AutomationId="ButtonGunakanFoto" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
