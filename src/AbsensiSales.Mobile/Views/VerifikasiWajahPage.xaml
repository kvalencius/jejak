<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AbsensiSales.Mobile.Views.VerifikasiWajahPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AbsensiSales.Mobile.ViewModels"
    x:DataType="vm:VerifikasiWajahViewModel"
    Title="Verifikasi Wajah"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,24" Spacing="0">

            <Label Text="Verifikasi wajah" Style="{StaticResource TitleLabel}" Margin="0,0,0,4" />
            <Label Text="{Binding NamaToko, StringFormat='{0} - Tahap 3 dari 5'}" Style="{StaticResource SubtitleLabel}" Margin="0,0,0,14" />

            <!-- Bingkai kamera -->
            <Border BackgroundColor="{StaticResource Navy}" StrokeThickness="0" StrokeShape="RoundRectangle 16" HeightRequest="300" Padding="0">
                <Grid>
                    <!-- Placeholder area kamera -->
                    <Label Text="KAMERA" TextColor="{StaticResource TextOnNavy}" FontSize="40" FontFamily="OpenSansSemibold" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Label Text="Kamera depan - Demo" BackgroundColor="#CC2B2319" TextColor="White" FontSize="12" Padding="8,4" HorizontalOptions="Start" VerticalOptions="Start" Margin="12,12,0,0" />

                    <!-- Lingkaran panduan wajah -->
                    <Border Stroke="{StaticResource Success}" StrokeThickness="2" StrokeShape="RoundRectangle 120" WidthRequest="180" HeightRequest="180" BackgroundColor="Transparent" HorizontalOptions="Center" VerticalOptions="Center" />

                    <Label Text="Posisikan wajah di dalam bingkai" BackgroundColor="#CC2B2319" TextColor="White" FontSize="12" Padding="12,6" HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,16" />
                </Grid>
            </Border>

            <!-- Hasil -->
            <Border Style="{StaticResource CardBorder}" Margin="0,14,0,12" IsVisible="{Binding SudahDiperiksa}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Hasil verifikasi" Style="{StaticResource SectionTitle}" />
                        <Label Grid.Column="1" Text="{Binding HasilCocok, Converter={StaticResource BoolToStatusConverter}}" Style="{StaticResource BadgeSuccess}" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Border Grid.Column="0" BackgroundColor="{StaticResource InfoBg}" StrokeThickness="0" StrokeShape="RoundRectangle 18" WidthRequest="34" HeightRequest="34">
                            <Label Text="WAJAH" FontSize="10" TextColor="{StaticResource PrimaryDark}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Identitas terdeteksi" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            <Label Text="{Binding IdentitasTerdeteksi}" FontFamily="OpenSansSemibold" FontSize="14" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="OK" TextColor="{StaticResource Success}" FontSize="16" VerticalOptions="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Border Grid.Column="0" BackgroundColor="{StaticResource InfoBg}" StrokeThickness="0" StrokeShape="RoundRectangle 18" WidthRequest="34" HeightRequest="34">
                            <Label Text="JAM" TextColor="{StaticResource PrimaryDark}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Waktu verifikasi" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            <Label Text="{Binding WaktuVerifikasi}" FontFamily="OpenSansSemibold" FontSize="14" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="OK" TextColor="{StaticResource Success}" FontSize="16" VerticalOptions="Center" />
                    </Grid>

                    <Label Text="{Binding RingkasanSkor}" Style="{StaticResource SubtitleLabel}" />
                    <Label Text="{Binding PesanHasil}" FontSize="13" TextColor="{StaticResource Danger}" />
                </VerticalStackLayout>
            </Border>

            <!-- Indikator memproses -->
            <Border Style="{StaticResource CardBorder}" Margin="0,14,0,12" IsVisible="{Binding HasilDiproses}">
                <HorizontalStackLayout Spacing="10">
                    <ActivityIndicator IsRunning="{Binding HasilDiproses}" Color="{StaticResource PrimaryDark}" />
                    <Label Text="Memindai wajah..." FontSize="14" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- Tips -->
            <Border BackgroundColor="{StaticResource InfoBg}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="14" Margin="0,0,0,14">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Agar wajah terbaca" TextColor="{StaticResource PrimaryDark}" FontFamily="OpenSansSemibold" FontSize="13" />
                    <Label Text="Hadapkan wajah ke kamera, gunakan cahaya yang cukup, dan lepas masker atau kacamata gelap." TextColor="{StaticResource TextSecondary}" FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Pindai wajah" Style="{StaticResource SecondaryButton}" Command="{Binding PindaiWajahCommand}" Margin="0,0,0,10" AutomationId="ButtonPindaiWajah" />
            <Button Text="Gunakan hasil &amp; lanjutkan >" Style="{StaticResource PrimaryButton}" Command="{Binding LanjutFotoCommand}" IsEnabled="{Binding HasilCocok}" AutomationId="ButtonLanjutFoto" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
