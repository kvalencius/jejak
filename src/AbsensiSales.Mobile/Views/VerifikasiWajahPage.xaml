<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AbsensiSales.Mobile.Views.VerifikasiWajahPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:AbsensiSales.Mobile.Controls"
    xmlns:vm="clr-namespace:AbsensiSales.Mobile.ViewModels"
    x:DataType="vm:VerifikasiWajahViewModel"
    Title="Verifikasi Wajah"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <Grid Padding="20,20,20,24" RowDefinitions="Auto,*,Auto" RowSpacing="0">

        <!-- Judul halaman -->
        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <controls:BackButton Margin="0,0,0,10" />
            <Label Text="Verifikasi wajah" Style="{StaticResource TitleLabel}" />
            <Label Text="{Binding NamaToko, StringFormat='{0} - cocokkan wajah Anda'}" Style="{StaticResource SubtitleLabel}" />
        </VerticalStackLayout>

        <!-- Area pindai -->
        <Grid Grid.Row="1" RowDefinitions="*,Auto" RowSpacing="14" Margin="0,14,0,0">

            <controls:SolidCard
                Grid.Row="0"
                Tone="Navy"
                Padding="0"
                MinimumHeightRequest="300"
                StrokeShape="RoundRectangle 24">
                <Grid RowDefinitions="Auto,*,Auto">

                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="16,14,16,0">
                        <Label Text="KAMERA WAJAH" TextColor="{StaticResource White}" FontSize="10" FontFamily="OpenSansSemibold" />
                        <Label Grid.Column="1" Text="FOTO TIDAK DISIMPAN" TextColor="{StaticResource Yellow}" FontSize="10" FontFamily="OpenSansSemibold" />
                    </Grid>

                    <!-- Bingkai wajah -->
                    <Grid
                        x:Name="Bingkai"
                        Grid.Row="1"
                        WidthRequest="210"
                        HeightRequest="210"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                        <Border
                            BackgroundColor="Transparent"
                            Stroke="{StaticResource Yellow}"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 105">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding Terverifikasi}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource Mint}" />
                                    <Setter Property="StrokeThickness" Value="3" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding PerluDaftar}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource NavyMuted}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding ModelTidakSiap}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource Coral}" />
                                </DataTrigger>
                            </Border.Triggers>
                        </Border>

                        <Path
                            Data="M 15,62 L 45,92 L 95,28"
                            Aspect="Uniform"
                            WidthRequest="110"
                            HeightRequest="120"
                            Stroke="{StaticResource Mint}"
                            StrokeThickness="8"
                            StrokeLineCap="Round"
                            StrokeLineJoin="Round"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            IsVisible="{Binding Terverifikasi}" />

                        <ActivityIndicator
                            Color="{StaticResource Yellow}"
                            WidthRequest="28"
                            HeightRequest="28"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            IsRunning="{Binding SedangMemindai}"
                            IsVisible="{Binding SedangMemindai}" />
                    </Grid>

                    <!-- Status di dalam bingkai -->
                    <Border
                        Grid.Row="2"
                        Margin="16,0,16,16"
                        Padding="16,9"
                        BackgroundColor="{StaticResource NavyDeep}"
                        HorizontalOptions="Center"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 14">
                        <Label
                            Text="{Binding JudulStatus}"
                            TextColor="{StaticResource White}"
                            FontFamily="OpenSansSemibold"
                            FontSize="12"
                            HorizontalTextAlignment="Center" />
                    </Border>
                </Grid>
            </controls:SolidCard>

            <!-- Keterangan status -->
            <VerticalStackLayout Grid.Row="1" Spacing="8">
                <HorizontalStackLayout
                    Spacing="8"
                    HorizontalOptions="Center"
                    IsVisible="{Binding SedangMemindai}">
                    <ActivityIndicator
                        Color="{StaticResource Navy}"
                        WidthRequest="18"
                        HeightRequest="18"
                        VerticalOptions="Center"
                        IsRunning="{Binding SedangMemindai}" />
                    <Label
                        Text="Mohon tunggu sebentar"
                        FontSize="12"
                        TextColor="{StaticResource TextSecondary}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Label
                    Text="{Binding PesanStatus}"
                    FontSize="12"
                    TextColor="{StaticResource TextSecondary}"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="{Binding LabelSkor}"
                    FontSize="11"
                    TextColor="{StaticResource Navy}"
                    FontFamily="OpenSansSemibold"
                    HorizontalTextAlignment="Center"
                    IsVisible="{Binding LabelSkor, Converter={StaticResource StringNotEmptyConverter}}" />
            </VerticalStackLayout>
        </Grid>

        <!-- Aksi -->
        <VerticalStackLayout Grid.Row="2" Spacing="10" Margin="0,18,0,0">

            <Button
                Text="Pindai wajah"
                Style="{StaticResource PrimaryButton}"
                Command="{Binding PindaiCommand}"
                IsVisible="{Binding BisaPindai}"
                AutomationId="ButtonPindaiWajah" />

            <Button
                Text="Daftarkan wajah dulu"
                Style="{StaticResource PrimaryButton}"
                Command="{Binding DaftarWajahCommand}"
                IsVisible="{Binding PerluDaftar}"
                AutomationId="ButtonDaftarWajah" />

            <controls:SolidCard Tone="Yellow" Padding="16" IsVisible="{Binding PerluDaftar}">
                <Label
                    Text="Absensi memerlukan wajah yang terdaftar. Tekan tombol di atas untuk memindai dan menyimpan wajah Anda, lalu verifikasi bisa dilakukan."
                    TextColor="{StaticResource TextSecondary}"
                    FontSize="11" />
            </controls:SolidCard>

        </VerticalStackLayout>
    </Grid>
</ContentPage>
