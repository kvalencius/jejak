<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AbsensiSales.Mobile.Views.VerifikasiWajahPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AbsensiSales.Mobile.ViewModels"
    x:DataType="vm:VerifikasiWajahViewModel"
    Title="Verifikasi Wajah"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,24" Spacing="0">

            <!-- Judul & mode verifikasi -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="Verifikasi wajah" Style="{StaticResource TitleLabel}" />
                    <Label Text="{Binding NamaToko, StringFormat='{0} - Tahap 3 dari 5'}" Style="{StaticResource SubtitleLabel}" />
                </VerticalStackLayout>
                <Label Grid.Column="1"
                       Text="{Binding LabelModeVerifikasi}"
                       IsVisible="{Binding LabelModeVerifikasi, Converter={StaticResource StringNotEmptyConverter}}"
                       VerticalOptions="Center">
                    <Label.Style>
                        <Style TargetType="Label" BasedOn="{StaticResource BadgeSuccess}">
                            <Style.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding ModeSimulasi}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource Warning}" />
                                    <Setter Property="BackgroundColor" Value="{StaticResource WarningBg}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Label.Style>
                </Label>
            </Grid>

            <!-- Pratinjau kamera perangkat -->
            <Border BackgroundColor="{StaticResource Navy}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    HeightRequest="330"
                    Padding="0"
                    Margin="0,16,0,0">
                <Grid>
                    <!-- Hasil foto kamera -->
                    <Image Source="{Binding PratinjauWajah}"
                           Aspect="AspectFill"
                           IsVisible="{Binding FotoSiap}" />

                    <!-- Panduan wajah saat belum ada foto -->
                    <Grid IsVisible="{Binding FotoSiap, Converter={StaticResource InvertedBoolConverter}}">
                        <Border WidthRequest="150"
                                HeightRequest="190"
                                Stroke="{StaticResource Primary}"
                                StrokeThickness="2"
                                BackgroundColor="Transparent"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <Ellipse />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="WAJAH"
                                       TextColor="{StaticResource TextOnNavy}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="12"
                                       HorizontalOptions="Center" />
                                <Label Text="di dalam bingkai"
                                       TextColor="{StaticResource TextOnNavy}"
                                       FontSize="10"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <Label Text="Posisikan wajah di dalam bingkai"
                               TextColor="{StaticResource TextOnNavy}"
                               FontSize="12"
                               HorizontalOptions="Center"
                               VerticalOptions="End"
                               Margin="0,0,0,18" />
                    </Grid>

                    <!-- Badge status kamera -->
                    <Label Text="{Binding LabelKamera}"
                           BackgroundColor="{StaticResource Scrim}"
                           TextColor="White"
                           FontFamily="OpenSansSemibold"
                           FontSize="11"
                           Padding="10,5"
                           HorizontalOptions="Start"
                           VerticalOptions="Start"
                           Margin="12" />

                    <!-- Overlay proses verifikasi -->
                    <Grid BackgroundColor="{StaticResource Scrim}" IsVisible="{Binding HasilDiproses}">
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                            <ActivityIndicator IsRunning="{Binding HasilDiproses}" Color="{StaticResource Primary}" />
                            <Label Text="Memeriksa wajah..."
                                   TextColor="White"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="13" />
                        </VerticalStackLayout>
                    </Grid>
                </Grid>
            </Border>

            <!-- Kontrol kamera -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,14,0,0">
                <Button Grid.Column="0"
                        Text="{Binding TeksTombolKamera}"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding PindaiWajahCommand}"
                        IsEnabled="{Binding HasilDiproses, Converter={StaticResource InvertedBoolConverter}}"
                        AutomationId="ButtonPindaiWajah" />
                <Border Grid.Column="1"
                        WidthRequest="52"
                        HeightRequest="52"
                        BackgroundColor="{StaticResource Primary}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 26"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PindaiWajahCommand}" />
                    </Border.GestureRecognizers>
                    <Border WidthRequest="24"
                            HeightRequest="24"
                            BackgroundColor="{StaticResource Surface}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- Pesan kamera -->
            <Label Text="{Binding PesanKamera}"
                   FontSize="12"
                   TextColor="{StaticResource Warning}"
                   Margin="0,8,0,0"
                   IsVisible="{Binding PesanKamera, Converter={StaticResource StringNotEmptyConverter}}" />

            <Button Text="Buka pengaturan izin"
                    Style="{StaticResource GhostButton}"
                    Command="{Binding BukaPengaturanIzinCommand}"
                    IsVisible="{Binding TampilkanPengaturan}"
                    HeightRequest="36"
                    FontSize="13"
                    Padding="4,0"
                    HorizontalOptions="Start"
                    AutomationId="ButtonPengaturanIzin" />

            <!-- Hasil verifikasi -->
            <Border Style="{StaticResource CardBorder}" Margin="0,14,0,12" IsVisible="{Binding SudahDiperiksa}">
                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Grid.Column="0"
                               Text="Hasil verifikasi"
                               Style="{StaticResource SectionTitle}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding HasilCocok, Converter={StaticResource BoolToStatusConverter}}">
                            <Label.Style>
                                <Style TargetType="Label" BasedOn="{StaticResource BadgeSuccess}">
                                    <Style.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding HasilCocok}" Value="False">
                                            <Setter Property="TextColor" Value="{StaticResource Danger}" />
                                            <Setter Property="BackgroundColor" Value="{StaticResource DangerBg}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Label.Style>
                        </Label>
                    </Grid>

                    <!-- Skor kecocokan -->
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Skor kecocokan" Style="{StaticResource CaptionLabel}" />
                            <Label Grid.Column="1"
                                   Text="{Binding RingkasanSkor}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="13" />
                        </Grid>
                        <ProgressBar Progress="{Binding SkorProgress}" />
                    </VerticalStackLayout>

                    <!-- Identitas -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Border Grid.Column="0" BackgroundColor="{StaticResource InfoBg}" StrokeThickness="0" StrokeShape="RoundRectangle 18" WidthRequest="36" HeightRequest="36">
                            <Label Text="WAJAH"
                                   FontSize="8"
                                   TextColor="{StaticResource PrimaryDark}"
                                   FontFamily="OpenSansSemibold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Identitas terdeteksi" Style="{StaticResource CaptionLabel}" />
                            <Label Text="{Binding IdentitasTerdeteksi}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2"
                               Text="OK"
                               TextColor="{StaticResource Success}"
                               FontFamily="OpenSansSemibold"
                               FontSize="15"
                               VerticalOptions="Center"
                               IsVisible="{Binding HasilCocok}" />
                    </Grid>

                    <!-- Waktu -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Border Grid.Column="0" BackgroundColor="{StaticResource InfoBg}" StrokeThickness="0" StrokeShape="RoundRectangle 18" WidthRequest="36" HeightRequest="36">
                            <Label Text="JAM"
                                   FontSize="9"
                                   TextColor="{StaticResource PrimaryDark}"
                                   FontFamily="OpenSansSemibold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Waktu verifikasi" Style="{StaticResource CaptionLabel}" />
                            <Label Text="{Binding WaktuVerifikasi}" FontFamily="OpenSansSemibold" FontSize="14" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2"
                               Text="OK"
                               TextColor="{StaticResource Success}"
                               FontFamily="OpenSansSemibold"
                               FontSize="15"
                               VerticalOptions="Center"
                               IsVisible="{Binding HasilCocok}" />
                    </Grid>

                    <Label Text="{Binding PesanHasil}"
                           FontSize="12"
                           TextColor="{StaticResource TextSecondary}"
                           IsVisible="{Binding PesanHasil, Converter={StaticResource StringNotEmptyConverter}}" />

                </VerticalStackLayout>
            </Border>

            <!-- Tips -->
            <Border BackgroundColor="{StaticResource InfoBg}" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="14" Margin="0,4,0,14">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Agar wajah cepat terbaca"
                           TextColor="{StaticResource PrimaryDark}"
                           FontFamily="OpenSansSemibold"
                           FontSize="13" />
                    <Label Text="Hadapkan wajah ke kamera dengan cahaya cukup, tanpa masker atau kacamata gelap. Foto diambil melalui kamera perangkat dan dipakai untuk verifikasi."
                           TextColor="{StaticResource TextSecondary}"
                           FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Gunakan hasil &amp; lanjutkan >"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding LanjutFotoCommand}"
                    IsEnabled="{Binding HasilCocok}"
                    AutomationId="ButtonLanjutFoto" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
