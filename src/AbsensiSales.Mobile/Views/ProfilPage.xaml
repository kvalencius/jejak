<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AbsensiSales.Mobile.Views.ProfilPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:AbsensiSales.Mobile.Controls"
    xmlns:vm="clr-namespace:AbsensiSales.Mobile.ViewModels"
    x:DataType="vm:ProfilViewModel"
    Title="Profil"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <Grid>

        <ScrollView>
            <VerticalStackLayout Padding="20,20,20,92" Spacing="0">

                <Label Text="Profil saya" Style="{StaticResource TitleLabel}" Margin="0,0,0,16" />

                <!-- Kartu identitas -->
                <controls:SolidCard Tone="Navy" Padding="18" Margin="0,0,0,14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <!-- <controls:SolidCard
                            Grid.Column="0"
                            Tone="Yellow"
                            Padding="0"
                            WidthRequest="58"
                            HeightRequest="58"
                            StrokeShape="RoundRectangle 29">
                            <Label
                                Text="{Binding Inisial}"
                                TextColor="{StaticResource Navy}"
                                FontFamily="InterBold"
                                FontSize="20"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </controls:SolidCard> -->
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label
                                Text="{Binding NamaSales}"
                                TextColor="{StaticResource White}"
                                FontFamily="InterBold"
                                FontSize="17" />
                            <Label
                                Text="{Binding Nip}"
                                TextColor="{StaticResource NavyMuted}"
                                FontSize="12" />
                            <Label
                                Text="{Binding Peran}"
                                TextColor="{StaticResource NavyMuted}"
                                FontSize="11" />
                        </VerticalStackLayout>
                    </Grid>
                </controls:SolidCard>

                <!-- Data akun -->
                <controls:SolidCard Tone="White" Margin="0,0,0,16">
                    <VerticalStackLayout Spacing="0">

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="0,4">
                            <Label Grid.Column="0" Text="NIP" Style="{StaticResource SubtitleLabel}" />
                            <Label
                                Grid.Column="1"
                                Text="{Binding Nip}"
                                FontFamily="OpenSansSemibold"
                                FontSize="13"
                                HorizontalTextAlignment="End" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" Margin="0,10" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="0,4">
                            <Label Grid.Column="0" Text="Wilayah" Style="{StaticResource SubtitleLabel}" />
                            <Label
                                Grid.Column="1"
                                Text="{Binding Wilayah}"
                                FontFamily="OpenSansSemibold"
                                FontSize="13"
                                HorizontalTextAlignment="End" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" Margin="0,10" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="0,4">
                            <Label Grid.Column="0" Text="Email" Style="{StaticResource SubtitleLabel}" />
                            <Label
                                Grid.Column="1"
                                Text="{Binding Email}"
                                FontFamily="OpenSansSemibold"
                                FontSize="13"
                                HorizontalTextAlignment="End" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" Margin="0,10" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="0,4">
                            <Label Grid.Column="0" Text="Data wajah" Style="{StaticResource SubtitleLabel}" />
                            <Label
                                Grid.Column="1"
                                Text="{Binding StatusWajah}"
                                FontFamily="OpenSansSemibold"
                                FontSize="13"
                                HorizontalTextAlignment="End" />
                        </Grid>

                    </VerticalStackLayout>
                </controls:SolidCard>

                <Button
                    Text="Kelola wajah"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding KelolaWajahCommand}"
                    Margin="0,0,0,10"
                    AutomationId="ButtonKelolaWajah" />

                <Button
                    Text="Keluar"
                    Style="{StaticResource NavyButton}"
                    Command="{Binding KeluarCommand}"
                    AutomationId="ButtonKeluar" />

            </VerticalStackLayout>
        </ScrollView>

        <controls:BottomNavBar
                ActiveTab="profil"
                VerticalOptions="End"
                Margin="16,0,16,14" />

        <controls:NotificationHost Margin="0,0,0,92" />

    </Grid>
</ContentPage>
