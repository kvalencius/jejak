<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AbsensiSales.Mobile.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:AbsensiSales.Mobile.Controls"
    xmlns:vm="clr-namespace:AbsensiSales.Mobile.ViewModels"
    x:DataType="vm:LoginViewModel"
    Title="Masuk"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="24,44,24,32"
                    Spacing="0">

                <!-- Logo -->
                <HorizontalStackLayout Spacing="10"
                        HorizontalOptions="Center">
                    <VerticalStackLayout Spacing="0"
                            VerticalOptions="Center">
                        <Image Source="logo_jejak.png"
                            WidthRequest="80"
                            HeightRequest="80"
                            Aspect="AspectFit"
                            Margin="0,0,0,10"/>
                        <Label Text="Jejak"
                                FontSize="30"
                                FontFamily="InterBold"/>
                        <Label Text="Absensi kunjungan sales"
                                FontSize="12"
                                TextColor="{StaticResource TextSecondary}"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <BoxView HeightRequest="20" />

                <Label Text="Selamat datang!"
                        Style="{StaticResource TitleLabel}"
                        Margin="10,30,0,6"
                        FontSize="18"/>
                
                <!-- Card login -->
                <controls:SolidCard Tone="White"
                        Padding="20,22">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="Email / No. Telp"
                                FontFamily="OpenSansSemibold"
                                FontSize="12"
                                Margin="0,0,0,6"/>
                        <controls:SolidCard Tone="White"
                                Padding="12,0"
                                Margin="0,0,0,14"
                                StrokeShape="RoundRectangle 14">
                            <Entry Text="{Binding Username}"
                                    Placeholder="Email atau No. telp"
                                    AutomationId="EntryUsername"/>
                        </controls:SolidCard>

                        <Label Text="Password"
                                FontFamily="OpenSansSemibold"
                                FontSize="12"
                                Margin="0,0,0,6"/>
                        <controls:SolidCard Tone="White"
                                Padding="12,0"
                                Margin="0,0,0,4"
                                StrokeShape="RoundRectangle 14">
                            <Entry Text="{Binding Password}"
                                    IsPassword="True"
                                    Placeholder="Masukkan password anda"
                                    AutomationId="EntryPassword"/>
                        </controls:SolidCard>
                        
                        <BoxView HeightRequest="20" />

                        <Button
                            Text="Masuk"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding MasukCommand}"
                            IsEnabled="{Binding SedangMemproses, Converter={StaticResource InvertedBoolConverter}}"
                            Margin="0,16,0,10"
                            AutomationId="ButtonLogin"/>

                        <Button
                            Text="Tes Koneksi Backend"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding TesKoneksiCommand}"
                            IsEnabled="{Binding SedangTesKoneksi, Converter={StaticResource InvertedBoolConverter}}"
                            HeightRequest="46"
                            Margin="0,0,0,8"
                            AutomationId="ButtonTesKoneksi"/>

                        <Label
                            Text="{Binding StatusKoneksi}"
                            TextColor="{StaticResource TextSecondary}"
                            FontSize="11"
                            LineBreakMode="WordWrap"
                            Margin="0,0,0,6"/>

                        <Label
                            Text="{Binding AlamatBackend, StringFormat='Backend: {0}'}"
                            TextColor="{StaticResource SubtleGray}"
                            FontSize="9"
                            LineBreakMode="CharacterWrap"
                            Margin="0,0,0,14"/>

                        <HorizontalStackLayout HorizontalOptions="Center"
                                Spacing="4">
                            <Label Text="Belum punya akun?"
                                    TextColor="{StaticResource TextSecondary}"
                                    FontSize="12"/>
                            <Label Text="Daftar sekarang"
                                    TextColor="{StaticResource Navy}"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="12">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BukaRegisterCommand}"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </controls:SolidCard>

                <Label Text="{Binding HariIni}"
                        HorizontalOptions="Center"
                        TextColor="{StaticResource TextSecondary}"
                        FontSize="11"
                        Margin="0,24,0,0"/>

            </VerticalStackLayout>
        </ScrollView>

        <controls:NotificationHost/>
    </Grid>
</ContentPage>


