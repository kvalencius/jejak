<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AbsensiSales.Mobile.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AbsensiSales.Mobile.ViewModels"
    x:DataType="vm:LoginViewModel"
    Title="Masuk"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24,48,24,32" Spacing="0">

            <!-- Logo -->
            <HorizontalStackLayout Spacing="10" VerticalOptions="Start">
                <Border Style="{StaticResource CardBorder}" Padding="8" StrokeShape="RoundRectangle 8" WidthRequest="36" HeightRequest="36">
                    <Label Text="JS" TextColor="{StaticResource PrimaryDark}" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="Jejak Sales" FontSize="18" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="Selamat datang kembali" Style="{StaticResource TitleLabel}" Margin="0,28,0,6" />
            <Label Text="Masuk untuk mencatat absensi, kunjungan toko, dan laporan harian Anda." Style="{StaticResource SubtitleLabel}" Margin="0,0,0,24" />

            <!-- Card login -->
            <Border Style="{StaticResource CardBorder}" Padding="20,24">
                <VerticalStackLayout Spacing="0">

                <!-- Tab Masuk / Daftar -->
                <Border Style="{StaticResource CardBorder}" Padding="4" StrokeThickness="0" BackgroundColor="{StaticResource Background}" Margin="0,0,0,20">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                        <Border Grid.Column="0" BackgroundColor="{StaticResource Surface}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="0,10">
                            <Label Text="Masuk" HorizontalOptions="Center" TextColor="{StaticResource PrimaryDark}" FontFamily="OpenSansSemibold" />
                        </Border>
                        <Border Grid.Column="1" BackgroundColor="Transparent" StrokeThickness="0" Padding="0,10">
                            <Label Text="Daftar" HorizontalOptions="Center" TextColor="{StaticResource TextSecondary}" />
                        </Border>
                    </Grid>
                </Border>

                <Label Text="Username" FontFamily="OpenSansSemibold" FontSize="13" Margin="0,0,0,6" />
                <Border Style="{StaticResource CardBorder}" Padding="12,0" Margin="0,0,0,14">
                    <Entry Text="{Binding Username}" Placeholder="username" AutomationId="EntryUsername" />
                </Border>

                <Label Text="Password" FontFamily="OpenSansSemibold" FontSize="13" Margin="0,0,0,6" />
                <Border Style="{StaticResource CardBorder}" Padding="12,0" Margin="0,0,0,8">
                    <Entry Text="{Binding Password}" IsPassword="True" Placeholder="--------" AutomationId="EntryPassword" />
                </Border>

                <Label Text="{Binding PesanError}" TextColor="{StaticResource Danger}" FontSize="13" Margin="0,4,0,0" />

                <Button
                    Text="Masuk >"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding MasukCommand}"
                    IsEnabled="{Binding SedangMemproses, Converter={StaticResource InvertedBoolConverter}}"
                    Margin="0,16,0,10"
                    AutomationId="ButtonLogin" />

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                    <Label Text="Belum punya akun?" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                    <Label Text="Daftar sekarang" TextColor="{StaticResource PrimaryDark}" FontFamily="OpenSansSemibold" FontSize="13">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BukaRegisterCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Info akun demo -->
            <Border BackgroundColor="{StaticResource InfoBg}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="14" Margin="0,16,0,0">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Akun untuk sales" TextColor="{StaticResource PrimaryDark}" FontFamily="OpenSansSemibold" FontSize="13" />
                    <Label Text="Demo: username andi.pratama / password demo123. Akses Admin HRD tersedia di aplikasi desktop." TextColor="{StaticResource TextSecondary}" FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding HariIni}" HorizontalOptions="Center" TextColor="{StaticResource TextSecondary}" FontSize="12" Margin="0,24,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
