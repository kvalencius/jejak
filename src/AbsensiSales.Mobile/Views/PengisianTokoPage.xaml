<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AbsensiSales.Mobile.Views.PengisianTokoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AbsensiSales.Mobile.ViewModels"
    x:DataType="vm:PengisianTokoViewModel"
    Title="Data Toko"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,24" Spacing="0">

            <Label Text="Pengisian data toko" Style="{StaticResource TitleLabel}" Margin="0,0,0,4" />
            <Label Text="Kunjungan - Tahap 2 dari 5" Style="{StaticResource SubtitleLabel}" Margin="0,0,0,12" />

            <!-- Banner absensi awal tercatat -->
            <Border BackgroundColor="{StaticResource SuccessBg}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="14" Margin="0,0,0,14">
                <VerticalStackLayout Spacing="2">
                    <Label Text="OK: Absensi pertama tercatat" TextColor="{StaticResource Success}" FontFamily="OpenSansSemibold" FontSize="13" />
                    <Label Text="{Binding WaktuAbsensiAwal, StringFormat='Tercatat pukul {0} WIB'}" TextColor="{StaticResource TextSecondary}" FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <!-- Detail toko -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Detail toko" Style="{StaticResource SectionTitle}" />

                    <Label Text="Toko tujuan *" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                    <Picker ItemsSource="{Binding DaftarToko}" ItemDisplayBinding="{Binding NamaToko}" SelectedItem="{Binding TokoTerpilih}" BackgroundColor="{StaticResource Background}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Nama toko" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            <Label Text="{Binding TokoTerpilih.NamaToko}" FontFamily="OpenSansSemibold" FontSize="14" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Kode toko" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            <Label Text="{Binding TokoTerpilih.KodeToko}" FontFamily="OpenSansSemibold" FontSize="14" />
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Alamat toko" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        <Label Text="{Binding TokoTerpilih.Alamat}" FontSize="14" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Nama pemilik" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            <Label Text="{Binding TokoTerpilih.Pemilik}" FontSize="14" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Nomor telepon" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            <Label Text="{Binding TokoTerpilih.Telepon}" FontSize="14" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Detail kunjungan -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Detail kunjungan" Style="{StaticResource SectionTitle}" />

                    <Label Text="Tujuan kunjungan *" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                    <Picker ItemsSource="{Binding PilihanTujuan}" SelectedItem="{Binding TujuanKunjungan}" BackgroundColor="{StaticResource Background}" />

                    <Label Text="Catatan" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                    <Border Style="{StaticResource CardBorder}" Padding="12" MinimumHeightRequest="80">
                        <Editor Text="{Binding Catatan}" Placeholder="Catatan kunjungan (opsional)" AutoSize="TextChanges" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Bukti otomatis -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Bukti otomatis" Style="{StaticResource SectionTitle}" />
                        <Label Grid.Column="1" Text="{Binding LabelRadius}" Style="{StaticResource BadgeSuccess}" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Border Grid.Column="0" BackgroundColor="{StaticResource InfoBg}" StrokeThickness="0" StrokeShape="RoundRectangle 18" WidthRequest="34" HeightRequest="34">
                            <Label Text="GPS" TextColor="{StaticResource PrimaryDark}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="GPS kunjungan" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            <Label Text="{Binding KoordinatGps}" FontFamily="OpenSansSemibold" FontSize="13" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="OK" TextColor="{StaticResource Success}" FontSize="16" VerticalOptions="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Border Grid.Column="0" BackgroundColor="{StaticResource InfoBg}" StrokeThickness="0" StrokeShape="RoundRectangle 18" WidthRequest="34" HeightRequest="34">
                            <Label Text="JAM" TextColor="{StaticResource PrimaryDark}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Waktu pengisian" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            <Label Text="{Binding WaktuPengisian}" FontFamily="OpenSansSemibold" FontSize="13" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="OK" TextColor="{StaticResource Success}" FontSize="16" VerticalOptions="Center" />
                    </Grid>

                    <Label Text="{Binding InfoJarak}" Style="{StaticResource SubtitleLabel}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="* Wajib diisi. Data toko, GPS, wajah, dan foto akan ditinjau sebelum disimpan." Style="{StaticResource SubtitleLabel}" Margin="0,0,0,12" />

            <Button Text="Lanjut ke verifikasi wajah >" Style="{StaticResource PrimaryButton}" Command="{Binding LanjutVerifikasiCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
