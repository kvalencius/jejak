<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AbsensiSales.Mobile.ViewModels"
             x:Class="AbsensiSales.Mobile.Views.AbsensiPertamaPage"
             x:DataType="vm:AbsensiPertamaViewModel"
             Title="Dashboard Absensi">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="20,20,20,28">

            <!-- Sapaan sales -->
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="2" Margin="0,0,0,4">
                <Border Grid.Column="0"
                        Grid.RowSpan="2"
                        WidthRequest="46"
                        HeightRequest="46"
                        BackgroundColor="{StaticResource PrimarySoft}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 23"
                        VerticalOptions="Center">
                    <Label Text="AP"
                           TextColor="{StaticResource PrimaryDark}"
                           FontFamily="OpenSansSemibold"
                           FontSize="15"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
                <Label Grid.Column="1"
                       Grid.Row="0"
                       Text="{Binding NamaSales}"
                       Style="{StaticResource TitleLabel}"
                       FontSize="22"
                       LineBreakMode="TailTruncation" />
                <Label Grid.Column="1"
                       Grid.Row="1"
                       Text="{Binding InfoSales}"
                       Style="{StaticResource SubtitleLabel}"
                       LineBreakMode="TailTruncation" />
                <Button Grid.Column="2"
                        Grid.RowSpan="2"
                        Text="Keluar"
                        Style="{StaticResource SecondaryButton}"
                        HeightRequest="36"
                        FontSize="13"
                        Padding="12,0"
                        VerticalOptions="Center"
                        Command="{Binding KeluarCommand}"
                        AutomationId="ButtonKeluar" />
            </Grid>

            <!-- Jam & tanggal -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Waktu saat ini" Style="{StaticResource CaptionLabel}" HorizontalOptions="Center" />
                    <Label Text="{Binding WaktuSekarang}"
                           FontSize="48"
                           FontFamily="OpenSansSemibold"
                           LineHeight="1.05"
                           HorizontalOptions="Center" />
                    <Label Text="{Binding TanggalManusia}"
                           FontSize="15"
                           FontFamily="OpenSansSemibold"
                           TextColor="{StaticResource PrimaryDark}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Progress kunjungan hari ini -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="Target kunjungan harian"
                               Style="{StaticResource SectionTitle}" />
                        <Label Grid.Column="1"
                               Text="{Binding LabelProgress}"
                               Style="{StaticResource CaptionLabel}"
                               VerticalOptions="Center" />
                    </Grid>
                    <ProgressBar Progress="{Binding Progress}" />
                </VerticalStackLayout>
            </Border>

            <!-- Tombol utama -->
            <Button Text="Mulai kunjungan / absen"
                    Style="{StaticResource PrimaryButton}"
                    HeightRequest="56"
                    FontSize="16"
                    Command="{Binding CatatAbsensiCommand}"
                    Margin="0,4,0,8" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
