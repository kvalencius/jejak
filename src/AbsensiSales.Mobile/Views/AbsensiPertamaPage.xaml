<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AbsensiSales.Mobile.Views.AbsensiPertamaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AbsensiSales.Mobile.ViewModels"
    x:DataType="vm:AbsensiPertamaViewModel"
    Title="Absensi">

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,24" Spacing="0">

            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,0,0,16">
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="8" StrokeShape="RoundRectangle 8" WidthRequest="34" HeightRequest="34">
                    <Label Text="JS" TextColor="{StaticResource PrimaryDark}" FontSize="15" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Grid.Column="1" Text="Jejak Sales" FontSize="17" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                <Label Grid.Column="2" Text="DATA DEMO" Style="{StaticResource BadgeInfo}" VerticalOptions="Center" />
            </Grid>

            <Label Text="Absensi pertama" Style="{StaticResource TitleLabel}" Margin="0,0,0,4" />
            <Label Text="{Binding TanggalManusia, StringFormat='{0} - Tahap 1 dari 5'}" Style="{StaticResource SubtitleLabel}" Margin="0,0,0,12" />

            <!-- Progress target harian 8 toko -->
            <Grid ColumnDefinitions="*" Margin="0,0,0,16">
                <Border BackgroundColor="{StaticResource Border}" StrokeThickness="0" StrokeShape="RoundRectangle 4" HeightRequest="6">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{StaticResource Primary}" Offset="{Binding Progress}" />
                            <GradientStop Color="Transparent" Offset="{Binding Progress}" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
            <Label Text="{Binding LabelProgress}" Style="{StaticResource SubtitleLabel}" Margin="0,-8,0,16" />

            <!-- Identitas sales -->
            <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,12">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Grid.Column="0" BackgroundColor="{StaticResource InfoBg}" StrokeThickness="0" StrokeShape="RoundRectangle 20" WidthRequest="36" HeightRequest="36">
                        <Label Text="AP" TextColor="{StaticResource PrimaryDark}" FontFamily="OpenSansSemibold" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding NamaSales}" FontFamily="OpenSansSemibold" FontSize="15" />
                        <Label Text="{Binding InfoSales}" Style="{StaticResource SubtitleLabel}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="{Binding StatusAbsensi}" Style="{StaticResource BadgeWarning}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Waktu saat ini -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="WAKTU SAAT INI - WIB" FontSize="11" TextColor="{StaticResource TextSecondary}" FontFamily="OpenSansSemibold" />
                    <Label Text="{Binding WaktuSekarang}" FontSize="34" FontFamily="OpenSansSemibold" TextColor="{StaticResource Navy}" />
                    <Label Text="Waktu dicatat otomatis saat absensi." Style="{StaticResource SubtitleLabel}" />
                </VerticalStackLayout>
            </Border>

            <!-- Lokasi -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Lokasi Anda" Style="{StaticResource SectionTitle}" />
                        <Label Grid.Column="1" Text="GPS siap" Style="{StaticResource BadgeSuccess}" />
                    </Grid>

                    <!-- Peta placeholder -->
                    <Border BackgroundColor="{StaticResource Background}" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="150" Padding="0">
                        <Grid>
                            <Label Text="Jl. Raya Darmo" TextColor="{StaticResource TextSecondary}" FontSize="11" Margin="12,10" />
                            <Label Text="TEGALSARI" TextColor="{StaticResource TextSecondary}" FontSize="10" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,16,16" />
                            <Label Text="{Binding LabelTokoContoh}" BackgroundColor="{StaticResource Navy}" TextColor="White" FontSize="11" Padding="8,4" HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,8" />
                            <Label Text="+" TextColor="{StaticResource PrimaryDark}" FontSize="30" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Label Text="{Binding AlamatTokoContoh}" FontFamily="OpenSansSemibold" FontSize="14" />
                    <Label Text="{Binding KoordinatContoh}" Style="{StaticResource SubtitleLabel}" />
                </VerticalStackLayout>
            </Border>

            <!-- Kesiapan perangkat -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Kesiapan perangkat" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="GPS" FontSize="16" />
                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                            <Label Text="Izin lokasi" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            <Label Text="Diizinkan - Lokasi presisi aktif" FontSize="13" FontFamily="OpenSansSemibold" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="OK" TextColor="{StaticResource Success}" FontSize="16" VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="FOTO" FontSize="16" />
                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                            <Label Text="Izin kamera" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            <Label Text="Diizinkan - Kamera siap" FontSize="13" FontFamily="OpenSansSemibold" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="OK" TextColor="{StaticResource Success}" FontSize="16" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button
                Text="Catat absensi pertama >"
                Style="{StaticResource PrimaryButton}"
                Command="{Binding CatatAbsensiCommand}"
                AutomationId="ButtonAbsensiPertama" />

            <Label Text="Demo - GPS disimulasikan di sekitar lokasi toko" HorizontalOptions="Center" TextColor="{StaticResource TextSecondary}" FontSize="12" Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
