<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AbsensiSales.Mobile.Views.AbsensiPertamaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:AbsensiSales.Mobile.Controls"
    xmlns:vm="clr-namespace:AbsensiSales.Mobile.ViewModels"
    x:DataType="vm:AbsensiPertamaViewModel"
    Title="Absensi"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20,20,20,20"
                    Spacing="0">

                <!-- Header -->
                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="10"
                    Margin="0,0,0,18">

                    <!-- Tombol Back -->
                    <controls:BackButton
                        Grid.Column="0"
                        FallbackRoute="//login"
                        Margin="0"
                        VerticalOptions="Center"/>

                    <!-- Logo, Nama, dan Status -->
                    <Grid
                        Grid.Column="1"
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="10"
                        VerticalOptions="Center">

                        <Image
                            Grid.Column="0"
                            Source="logo_jejak.png"
                            WidthRequest="40"
                            HeightRequest="40"
                            Aspect="AspectFit"
                            VerticalOptions="Center"/>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="1"
                            VerticalOptions="Center">

                            <Label
                                Text="Jejak Sales"
                                FontSize="16"
                                FontFamily="InterBold"/>

                            <Label
                                Text="Absensi kunjungan harian"
                                FontSize="11"
                                TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>

                    </Grid>
                </Grid>

                <BoxView HeightRequest="15" />

                <Label Text="{Binding JudulAbsensi}"
                        Style="{StaticResource TitleLabel}"
                        Margin="0,0,0,4"/>
                <Label Text="{Binding TanggalManusia}"
                        Style="{StaticResource SubtitleLabel}"
                        Margin="0,0,0,14"/>

                <!-- Progress target harian 8 toko -->
                <ProgressBar
                    Progress="{Binding Progress}"
                    ProgressColor="{StaticResource Navy}"
                    BackgroundColor="{StaticResource YellowSoft}"
                    HeightRequest="8"
                    Margin="0,0,0,6"/>
                <Label Text="{Binding LabelProgress}"
                        Style="{StaticResource SubtitleLabel}"
                        Margin="0,0,0,16"/>

                <!-- Target harian tercapai -->
                <controls:SolidCard Tone="Yellow"
                        Padding="14"
                        Margin="0,0,0,14"
                        IsVisible="{Binding TargetTercapai}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Semua kunjungan hari ini selesai"
                                TextColor="{StaticResource Navy}"
                                FontFamily="OpenSansSemibold"
                                FontSize="14"/>
                        <Label Text="Target 8 toko sudah tercapai. Terima kasih atas kerja hari ini."
                                TextColor="{StaticResource TextSecondary}"
                                FontSize="12"/>
                    </VerticalStackLayout>
                </controls:SolidCard>

                <!-- Identitas sales -->
                <controls:SolidCard Tone="White"
                        Padding="14"
                        Margin="0,0,0,12">
                    <Grid ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="12">
                        <controls:SolidCard
                            Grid.Column="0"
                            Tone="Yellow"
                            Padding="0"
                            WidthRequest="38"
                            HeightRequest="38"
                            StrokeShape="RoundRectangle 19">
                            <Label
                                Text="{Binding Inisial}"
                                TextColor="{StaticResource Navy}"
                                FontFamily="OpenSansSemibold"
                                FontSize="12"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"/>
                        </controls:SolidCard>
                        <VerticalStackLayout Grid.Column="1"
                                Spacing="2"
                                VerticalOptions="Center">
                            <Label Text="{Binding NamaSales}"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="15"/>
                            <Label Text="{Binding InfoSales}"
                                    Style="{StaticResource SubtitleLabel}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2"
                                Text="{Binding StatusAbsensi}"
                                Style="{StaticResource BadgeWarning}"
                                VerticalOptions="Center"/>
                    </Grid>
                </controls:SolidCard>

                <!-- Waktu saat ini -->
                <controls:SolidCard Tone="Navy"
                        Margin="0,0,0,12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding WaktuSekarang}"
                                FontSize="36"
                                FontFamily="OpenSansSemibold"
                                TextColor="{StaticResource White}"/>
                    </VerticalStackLayout>
                </controls:SolidCard>

                <!-- Lokasi -->
                <controls:SolidCard Tone="White"
                        Margin="0,0,0,12">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                    Text="Lokasi Anda"
                                    Style="{StaticResource SectionTitle}"/>
                            <Label Grid.Column="1"
                                    Text="GPS siap"
                                    Style="{StaticResource BadgeSuccess}"/>
                        </Grid>

                        <!-- Peta OpenStreetMap (gratis, tanpa API key) -->
                        <WebView
                            Source="{Binding PetaUrl}"
                            HeightRequest="240"
                            HorizontalOptions="Fill"
                            VerticalOptions="Start"/>

                        <Label Text="{Binding AlamatLokasi}"
                                FontFamily="OpenSansSemibold"
                                FontSize="14"/>
                        <Label Text="{Binding KoordinatLokasi}"
                                Style="{StaticResource SubtitleLabel}"/>
                    </VerticalStackLayout>
                </controls:SolidCard>


                <Button
                    Text="{Binding LabelTombol}"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding CatatAbsensiCommand}"
                    IsEnabled="{Binding BisaAbsen}"
                    AutomationId="ButtonAbsensiPertama"/>

                <Label Text="Lokasi diambil dari GPS perangkat. Pastikan izin lokasi aktif."
                        HorizontalOptions="Center"
                        TextColor="{StaticResource TextSecondary}"
                        FontSize="11"
                        Margin="0,10,0,0"/>

            </VerticalStackLayout>
        </ScrollView>

        <controls:BottomNavBar Grid.Row="1"
                ActiveTab="absensi"
                Margin="16,4,16,14"/>

        <controls:NotificationHost Grid.RowSpan="2"
                Margin="0,0,0,92"/>

    </Grid>
</ContentPage>
