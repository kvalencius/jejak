<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AbsensiSales.Mobile.Views.LaporanPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:AbsensiSales.Mobile.Controls"
    xmlns:vm="clr-namespace:AbsensiSales.Mobile.ViewModels"
    x:DataType="vm:LaporanViewModel"
    Title="Laporan"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <Grid>

        <ScrollView>
            <VerticalStackLayout Padding="20,20,20,92" Spacing="0">

                <!-- Header -->
                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="10"
                    Margin="0,0,0,18">

                    <!-- Tombol Back -->
                    <controls:BackButton
                        Grid.Column="0"
                        FallbackRoute="//login"
                        Margin="0"
                        VerticalOptions="Center"/>

                    <!-- Logo, Nama, dan Status -->
                    <Grid
                        Grid.Column="1"
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="10"
                        VerticalOptions="Center">

                        <Image
                            Grid.Column="0"
                            Source="logo_jejak.png"
                            WidthRequest="40"
                            HeightRequest="40"
                            Aspect="AspectFit"
                            VerticalOptions="Center"/>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="1"
                            VerticalOptions="Center">

                            <Label
                                Text="Jejak Sales"
                                FontSize="16"
                                FontFamily="InterBold"/>

                        </VerticalStackLayout>

                    </Grid>
                </Grid>

                <Label Text="Laporan saya" Style="{StaticResource TitleLabel}" Margin="0,0,0,4" />
                <!-- <Label Text="{Binding InfoSales}" Style="{StaticResource SubtitleLabel}" Margin="0,0,0,16" /> -->

                <!-- Pilih tanggal (tampilan) -->
                <controls:SolidCard Tone="Navy" Padding="14" Margin="0,0,0,12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <controls:SolidCard Grid.Column="0" Tone="Yellow" Padding="0" WidthRequest="38" HeightRequest="38" StrokeShape="RoundRectangle 12">
                            <Label Text="TGL" FontSize="9" TextColor="{StaticResource Navy}" FontFamily="OpenSansSemibold" HorizontalOptions="Center" VerticalOptions="Center" />
                        </controls:SolidCard>
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="Tanggal laporan" FontSize="11" TextColor="{StaticResource White}" />
                            <Label Text="{Binding JudulTanggal}" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{StaticResource White}" />
                        </VerticalStackLayout>
                    </Grid>
                </controls:SolidCard>

                <!-- Kartu ringkasan -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,0,0,14">
                    <controls:SolidCard Grid.Column="0" Tone="Navy">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Kunjungan" FontSize="11" TextColor="{StaticResource White}" />
                            <Label Text="{Binding JumlahKunjungan}" FontSize="32" FontFamily="OpenSansSemibold" TextColor="{StaticResource White}" />
                            <Label Text="{Binding StatusTargetHarian}" FontSize="11" TextColor="{StaticResource White}" />
                        </VerticalStackLayout>
                    </controls:SolidCard>

                    <controls:SolidCard Grid.Column="1" Tone="Yellow">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Absensi pertama" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                            <Label Text="{Binding AbsensiPertama}" FontSize="32" FontFamily="OpenSansSemibold" TextColor="{StaticResource Navy}" />
                            <Label Text="{Binding StatusAbsensiPertama}" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                    </controls:SolidCard>
                </Grid>

                <!-- Aksi -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,0,0,18">
                    <Button Grid.Column="0" Text="+ Ajukan izin" Style="{StaticResource SecondaryButton}" Command="{Binding AjukanIzinCommand}" HeightRequest="46" AutomationId="ButtonAjukanIzin" />
                    <Button Grid.Column="1" Text="Status permohonan" Style="{StaticResource SecondaryButton}" Command="{Binding LihatStatusPermohonanCommand}" HeightRequest="46" AutomationId="ButtonStatusPermohonan" />
                </Grid>

                <!-- Riwayat kunjungan -->
                <Label Text="Riwayat kunjungan" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />

                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding DaftarKunjungan}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:LaporanItemViewModel">
                            <controls:SolidCard Tone="White">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="{Binding NamaToko}" FontFamily="OpenSansSemibold" FontSize="15" />
                                        <Label Grid.Column="1" Text="{Binding Status}" Style="{StaticResource BadgeSuccess}" />
                                    </Grid>
                                    <Label Text="{Binding KodeToko, StringFormat='{0} - kunjungan tercatat'}" Style="{StaticResource SubtitleLabel}" />
                                    <Label Text="{Binding Alamat}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                                    <HorizontalStackLayout Spacing="12">
                                        <Label Text="{Binding CheckGps}" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                        <Label Text="{Binding CheckWajah}" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                        <Label Text="{Binding CheckFoto}" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </controls:SolidCard>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <controls:BottomNavBar
                ActiveTab="laporan"
                VerticalOptions="End"
                Margin="16,0,16,14" />

        <controls:NotificationHost Margin="0,0,0,92" />

    </Grid>
</ContentPage>
