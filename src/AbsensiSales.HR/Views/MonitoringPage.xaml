<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AbsensiSales.HR.Views.MonitoringPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AbsensiSales.HR.ViewModels"
    xmlns:controls="clr-namespace:AbsensiSales.HR.Controls"
    x:DataType="vm:MonitoringViewModel"
    Title="Pemantauan Absensi">

    <ScrollView>
        <VerticalStackLayout Padding="28,20" Spacing="0">

            <Label Text="Pemantauan absensi sales" Style="{StaticResource PageTitle}" Margin="0,0,0,4" />
            <Label Text="Pantau kehadiran, bukti kunjungan, dan status verifikasi dari seluruh sales di satu tempat." Style="{StaticResource PageSubtitle}" Margin="0,0,0,16" />

            <!-- Kartu statistik -->
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6" Margin="0,0,0,10">
                <controls:FloatingCard Grid.Column="0" Style="{StaticResource StatCard}">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Total sales" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        <Label Text="{Binding TotalSales}" FontSize="28" FontFamily="OpenSansSemibold" />
                        <Label Text="Tim Jawa Timur" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                </controls:FloatingCard>
                <controls:FloatingCard Grid.Column="1" Style="{StaticResource StatCard}">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Hadir" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        <Label Text="{Binding JumlahHadir}" FontSize="28" FontFamily="OpenSansSemibold" TextColor="{StaticResource Success}" />
                        <Label Text="{Binding PersenHadir}" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                </controls:FloatingCard>
                <controls:FloatingCard Grid.Column="2" Style="{StaticResource StatCard}">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Belum absen" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        <Label Text="{Binding JumlahBelumAbsen}" FontSize="28" FontFamily="OpenSansSemibold" TextColor="{StaticResource Warning}" />
                        <Label Text="Perlu tindak lanjut" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                </controls:FloatingCard>
                <controls:FloatingCard Grid.Column="3" Style="{StaticResource StatCard}">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Kunjungan tercatat" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        <Label Text="{Binding KunjunganTercatat}" FontSize="28" FontFamily="OpenSansSemibold" TextColor="{StaticResource PrimaryDark}" />
                        <Label Text="Hari ini" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                </controls:FloatingCard>
            </Grid>

            <!-- Daftar pemantauan -->
            <controls:FloatingCard Style="{StaticResource Card}" Margin="0,6,0,0">
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <Label Grid.Column="0" Text="Daftar pemantauan" Style="{StaticResource SectionTitle}" />
                        <Label Grid.Column="1" Text="{Binding UpdatePada, StringFormat='Update {0}'}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                    </Grid>

                    <!-- Header tabel -->
                    <Grid ColumnDefinitions="40,*,120,90" ColumnSpacing="8" BackgroundColor="{StaticResource SurfaceAlt}" Padding="8,6">
                        <Label Grid.Column="1" Text="Sales" Style="{StaticResource TableHeader}" />
                        <Label Grid.Column="2" Text="Status" Style="{StaticResource TableHeader}" />
                        <Label Grid.Column="3" Text="Waktu" Style="{StaticResource TableHeader}" />
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding DaftarSales}" Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:SalesMonitorItem">
                                <Grid ColumnDefinitions="40,*,120,90" ColumnSpacing="8" Padding="8,10">
                                    <Border Grid.Column="0" BackgroundColor="{StaticResource InfoBg}" StrokeThickness="0" StrokeShape="RoundRectangle 18" WidthRequest="36" HeightRequest="36">
                                        <Label Text="{Binding Inisial}" TextColor="{StaticResource PrimaryDark}" FontFamily="OpenSansSemibold" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label Text="{Binding Nama}" FontFamily="OpenSansSemibold" FontSize="13" />
                                        <Label Text="{Binding Nip, StringFormat='{0} - Surabaya Pusat'}" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding Status}" Style="{StaticResource BadgeSuccess}" HorizontalOptions="Start" />
                                    <Label Grid.Column="3" Text="{Binding Waktu}" Style="{StaticResource TableCell}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </controls:FloatingCard>

            <!-- Tindak lanjut -->
            <controls:FloatingCard Style="{StaticResource Card}" Margin="0,10,0,0">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Tindak lanjut" Style="{StaticResource SectionTitle}" />
                    <Label Text="{Binding RingkasanTindakLanjut}" Style="{StaticResource PageSubtitle}" />
                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="10" HorizontalOptions="Start">
                        <Button Grid.Column="0" Text="Buka laporan >" Style="{StaticResource SecondaryButton}" Command="{Binding BukaLaporanCommand}" />
                        <Button Grid.Column="1" Text="Kirim pengingat" Style="{StaticResource PrimaryButton}" Command="{Binding KirimPengingatCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </controls:FloatingCard>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
