<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AbsensiSales.HR.Views.MasterDataPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AbsensiSales.HR.ViewModels"
    xmlns:models="clr-namespace:AbsensiSales.Core.Models;assembly=AbsensiSales.Core"
    xmlns:controls="clr-namespace:AbsensiSales.HR.Controls"
    x:DataType="vm:MasterDataViewModel"
    Title="Data Master">

    <ScrollView>
        <VerticalStackLayout Padding="28,20" Spacing="0">

            <Label Text="Data master" Style="{StaticResource PageTitle}" Margin="0,0,0,4" />
            <Label Text="Kelola data sales dan toko mitra yang menjadi rujukan sistem absensi." Style="{StaticResource PageSubtitle}" Margin="0,0,0,16" />

            <!-- Tab Sales / Toko -->
            <controls:FloatingCard Style="{StaticResource Card}" Padding="4">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                    <Border Grid.Column="0" BackgroundColor="{StaticResource PrimaryBright}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="0,10">
                        <Label Text="{Binding JumlahSales, StringFormat='Sales ({0})'}" HorizontalOptions="Center" TextColor="{StaticResource OnPrimary}" FontFamily="OpenSansSemibold" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TampilkanSalesCommand}" />
                        </Border.GestureRecognizers>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="Transparent" StrokeThickness="0" Padding="0,10">
                        <Label Text="{Binding JumlahToko, StringFormat='Toko ({0})'}" HorizontalOptions="Center" TextColor="{StaticResource TextSecondary}" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TampilkanTokoCommand}" />
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>
            </controls:FloatingCard>

            <!-- Tabel sales -->
            <controls:FloatingCard Style="{StaticResource Card}" Margin="0,10,0,0" IsVisible="{Binding IsTabSales}">
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                        <Label Grid.Column="0" Text="Daftar sales" Style="{StaticResource SectionTitle}" />
                        <Button Grid.Column="1" Text="+ Tambah sales" Style="{StaticResource PrimaryButton}" Command="{Binding TambahSalesCommand}" HeightRequest="36" />
                    </Grid>

                    <Grid ColumnDefinitions="40,1.2*,1*,1.2*" ColumnSpacing="8" BackgroundColor="{StaticResource SurfaceAlt}" Padding="8,6">
                        <Label Grid.Column="1" Text="Nama" Style="{StaticResource TableHeader}" />
                        <Label Grid.Column="2" Text="NIP" Style="{StaticResource TableHeader}" />
                        <Label Grid.Column="3" Text="Wilayah" Style="{StaticResource TableHeader}" />
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding DaftarSales}" Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Sales">
                                <Grid ColumnDefinitions="40,1.2*,1*,1.2*" ColumnSpacing="8" Padding="8,10">
                                    <Border Grid.Column="0" BackgroundColor="{StaticResource InfoBg}" StrokeThickness="0" StrokeShape="RoundRectangle 18" WidthRequest="34" HeightRequest="34">
                                        <Label Text="{Binding Inisial}" TextColor="{StaticResource PrimaryDark}" FontFamily="OpenSansSemibold" FontSize="11" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Grid.Column="1" Text="{Binding Nama}" Style="{StaticResource TableCell}" FontFamily="OpenSansSemibold" />
                                    <Label Grid.Column="2" Text="{Binding Nip}" Style="{StaticResource TableCell}" />
                                    <Label Grid.Column="3" Text="{Binding Wilayah}" Style="{StaticResource TableCell}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </controls:FloatingCard>

            <!-- Tabel toko -->
            <controls:FloatingCard Style="{StaticResource Card}" Margin="0,10,0,0" IsVisible="{Binding IsTabToko}">
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                        <Label Grid.Column="0" Text="Daftar toko mitra" Style="{StaticResource SectionTitle}" />
                        <Button Grid.Column="1" Text="+ Tambah toko" Style="{StaticResource PrimaryButton}" Command="{Binding TambahTokoCommand}" HeightRequest="36" />
                    </Grid>

                    <Grid ColumnDefinitions="1*,1.2*,1.6*,90" ColumnSpacing="8" BackgroundColor="{StaticResource SurfaceAlt}" Padding="8,6">
                        <Label Grid.Column="0" Text="Kode" Style="{StaticResource TableHeader}" />
                        <Label Grid.Column="1" Text="Nama toko" Style="{StaticResource TableHeader}" />
                        <Label Grid.Column="2" Text="Alamat" Style="{StaticResource TableHeader}" />
                        <Label Grid.Column="3" Text="Radius" Style="{StaticResource TableHeader}" />
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding DaftarToko}" Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Toko">
                                <Grid ColumnDefinitions="1*,1.2*,1.6*,90" ColumnSpacing="8" Padding="8,10">
                                    <Label Grid.Column="0" Text="{Binding KodeToko}" Style="{StaticResource TableCell}" FontFamily="OpenSansSemibold" />
                                    <Label Grid.Column="1" Text="{Binding NamaToko}" Style="{StaticResource TableCell}" />
                                    <Label Grid.Column="2" Text="{Binding Alamat}" Style="{StaticResource TableCell}" />
                                    <Label Grid.Column="3" Text="{Binding RadiusMeter, StringFormat='{0:F0} m'}" Style="{StaticResource TableCell}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </controls:FloatingCard>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
