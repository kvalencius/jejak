<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AbsensiSales.HR.Views.HrRegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AbsensiSales.HR.ViewModels"
    xmlns:controls="clr-namespace:AbsensiSales.HR.Controls"
    x:DataType="vm:HrRegisterViewModel"
    Title="Daftar Admin HRD"
    BackgroundColor="{StaticResource Background}"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="48" Spacing="12" MaximumWidthRequest="520" HorizontalOptions="Center" VerticalOptions="Center">

            <Label Text="Daftar Admin HRD" FontSize="26" FontFamily="OpenSansSemibold" />
            <Label Text="Buat akun HRD untuk mengelola data absensi dan permohonan sales." Style="{StaticResource PageSubtitle}" Margin="0,0,0,8" />

            <controls:FloatingCard Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Nama lengkap" FontFamily="OpenSansSemibold" FontSize="13" />
                    <Border Style="{StaticResource InputCard}">
                        <Entry Text="{Binding Nama}" Placeholder="Nama HRD" />
                    </Border>

                    <Label Text="Email" FontFamily="OpenSansSemibold" FontSize="13" />
                    <Border Style="{StaticResource InputCard}">
                        <Entry Text="{Binding Email}" Placeholder="hrd@indopelita.id" Keyboard="Email" />
                    </Border>

                    <Label Text="Username" FontFamily="OpenSansSemibold" FontSize="13" />
                    <Border Style="{StaticResource InputCard}">
                        <Entry Text="{Binding Username}" Placeholder="username" />
                    </Border>

                    <Label Text="Password" FontFamily="OpenSansSemibold" FontSize="13" />
                    <Border Style="{StaticResource InputCard}">
                        <Entry Text="{Binding Password}" IsPassword="True" Placeholder="Minimal 6 karakter" />
                    </Border>

                    <Button Text="Daftar >" Style="{StaticResource PrimaryButton}" Command="{Binding DaftarCommand}" Margin="0,8,0,4" />
                    <Button Text="Kembali" Style="{StaticResource SecondaryButton}" Command="{Binding KembaliCommand}" />
                </VerticalStackLayout>
            </controls:FloatingCard>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
